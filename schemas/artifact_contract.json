    "required_columns": [
      "sample_id",
      "kernel",
      "gname",
      "key",
      "dataset_role",
      "split",
      "support_query",
      "cache_split",
      "file_name",
      "actual_perf",
      "seed",
      "k",
      "selection",
      "y_true_perf",
      "y_pred_perf",
      "y_true_util_LUT",
      "y_pred_util_LUT",
      "y_true_util_FF",
      "y_pred_util_FF",
      "y_true_util_DSP",
      "y_pred_util_DSP",
      "y_true_util_BRAM",
      "y_pred_util_BRAM"
    ]
  },
  "stage5e_directory": {
    "required_files_for_stage5i": [
      "selection_lock.json",
      "stage5e_convex_weights.csv",
      "target_query_predictions.csv"
    ],
    "optional_file": "target_support_predictions.csv",
    "selection_lock_requirement": "candidate paths must be relative or regenerated; no machine-specific absolute paths"
  },
  "comparison_prediction_directory": {
    "models": {"gnndse": "GNN-DSE", "ironman": "IronMan-Pro", "sgformer": "SGFormer", "mpm": "MPM"},
    "layout": "artifacts/inputs/baselines/<model>/seed{1..5}/",
    "required_files": ["target_query_predictions.csv", "prediction_export.json"],
    "required_metadata_columns": ["sample_id", "kernel", "seed", "model"],
    "required_target_columns": "y_true_<target> and y_pred_<target> for perf, util_LUT, util_FF, util_DSP, util_BRAM",
    "query_rows": 837,
    "evaluation_space": "same labels and sample IDs as each seed's HMoE query manifest; final predictions are already converted to that label space",
    "role": "comparison only; not members of the HARES correction pool"
  },
  "ablation_output_directory": {
    "layout": "artifacts/ablation/",
    "required_files": ["definition.json", "all_support_selections_locked.json", "per_seed.csv", "mean_std.csv", "ablation_table.tex", "input_checksums.csv", "completion.json"],
    "variants": ["anchor_only", "uniform_direct", "learned_direct", "uniform_anchored", "learned_anchored"],
    "prediction_layout": "seed{1..5}/<variant>/target_query_predictions.csv",
    "selection": "Both pools use the same support-only shrinkage rule; all five seeds are locked before query evaluation. Learned weights and masks are replayed from the main experiment."
  },
  "hmoe_directory": {
    "required_files": [
      "target_support_predictions.csv",
      "target_query_predictions.csv"
    ]
  }
